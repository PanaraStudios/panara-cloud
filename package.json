{
	"name": "panara-cloud",
	"version": "0.1.7",
	"private": true,
	"description": "Open-source, self-hosted Platform as a Service",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/PanaraStudios/panara-cloud"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:backend": "pnpm --filter @panara-cloud/backend dev",
		"dev:web": "pnpm --filter @panara-cloud/web dev",
		"dev:agent": "pnpm --filter @panara-cloud/agent dev",
		"test": "pnpm --filter @panara-cloud/backend test && pnpm --filter @panara-cloud/agent test",
		"test:e2e": "pnpm --filter @panara-cloud/web test:e2e",
		"typecheck": "pnpm -r run typecheck",
		"build": "pnpm -r run build",
		"format-and-lint": "biome check .",
		"dead-code": "knip",
		"check-version": "node scripts/check-version.mjs",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^24.4.0",
		"esbuild": "0.25.0",
		"knip": "6.47.0",
		"tsx": "4.22.4"
	},
	"packageManager": "pnpm@10.22.0",
	"engines": {
		"node": "^24.22.1",
		"pnpm": ">=9.12.0"
	},
	"pnpm": {
		"overrides": {
			"@panara-cloud/web>@types/react": "19.2.14",
			"@panara-cloud/web>@types/react-dom": "19.2.3",
			"esbuild": "0.25.0",
			"better-call@<1.4.0": "1.3.7",
			"@better-fetch/fetch@<1.3.3": "1.3.1",
			"mysql2": ">=3.23.1 <4.0.0",
			"deepmerge-ts": ">=8.0.0 <9.0.0",
			"@ai-sdk/provider-utils": ">=4.0.33 <5.0.0",
			"hono": ">=4.13.16 <5.0.0",
			"@hono/node-server": ">=2.1.6 <3.0.0",
			"lodash": "4.18.1",
			"postcss": ">=8.5.23 <9.0.0",
			"effect": ">=3.20.0 <4.0.0",
			"tar-fs": ">=2.1.4 <3.0.0",
			"uuid": ">=11.1.1 <12.0.0",
			"valibot": ">=1.4.2 <2.0.0",
			"proxy-addr": ">=2.0.8 <3.0.0",
			"source-map-js": ">=1.2.2 <2.0.0",
			"ip-address": ">=10.7.4 <11.0.0",
			"vite": ">=7.3.7 <8.0.0",
			"@vitest/mocker": ">=4.1.12 <5.0.0",
			"postcss-selector-parser": ">=7.1.6 <8.0.0",
			"sharp": ">=0.35.5 <0.36.0",
			"@modelcontextprotocol/sdk": ">=1.31.0 <2.0.0",
			"systeminformation": ">=5.33.16 <6.0.0",
			"undici@>=6.0.0 <7.0.0": ">=6.29.1 <7.0.0",
			"undici@>=7.0.0 <8.0.0": ">=7.30.1 <8.0.0",
			"body-parser@>=2.0.0 <3.0.0": ">=2.4.0 <3.0.0",
			"qs": ">=6.16.1 <7.0.0",
			"glob@>=9.0.0 <14.0.2": ">=14.0.2 <15.0.0",
			"minimatch@>=9.0.0 <11.0.1": ">=11.0.1 <12.0.0"
		},
		"peerDependencyRules": {
			"ignoreMissing": [
				"prisma",
				"@prisma/client",
				"@prisma/engines",
				"@electric-sql/pglite",
				"typescript"
			]
		},
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"cpu-features",
			"esbuild",
			"ssh2"
		]
	}
}
