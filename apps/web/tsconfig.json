{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"types": ["vite/client", "node"],
		"paths": {
			"@/*": ["./*"],
			// Packages without a React peer (convex) could otherwise
			// resolve another @types/react through pnpm's hoisting. Point every
			// import at this app's types.
			"react": ["./node_modules/@types/react"],
			"react/*": ["./node_modules/@types/react/*"],
			"react-dom": ["./node_modules/@types/react-dom"],
			"react-dom/*": ["./node_modules/@types/react-dom/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": [
		"node_modules",
		"dist",
		"server",
		"test-results",
		"playwright-report",
		"lib/**/*.test.ts"
	]
}
