{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./*"],
			// Packages without a React peer (next, convex) could otherwise
			// resolve another @types/react through pnpm's hoisting. Point every
			// import at this app's types.
			"react": ["./node_modules/@types/react"],
			"react/*": ["./node_modules/@types/react/*"],
			"react-dom": ["./node_modules/@types/react-dom"],
			"react-dom/*": ["./node_modules/@types/react-dom/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"test-results",
		"playwright-report",
		"lib/**/*.test.ts"
	]
}
